{
  "name": "roxane-foare-astro",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Portfolio Roxane Foare - site Astro bilingue EN/FR, en production sur Vercel.",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "thumbs": "node scripts/fetch-thumbs.mjs",
    "predev": "node scripts/fetch-thumbs.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/fetch-thumbs.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "start": "node server/index.mjs",
    "astro": "astro",
    "check": "astro check",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test a11y",
    "validate:html": "html-validate \"dist/**/*.html\""
  },
  "dependencies": {
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@sveltia/cms": "^0.230.1",
    "@types/node": "^26.6.5",
    "astro": "^7.4.0",
    "eslint": "^10.10.0",
    "eslint-plugin-astro": "^3.1.0",
    "globals": "^17.12.0",
    "html-validate": "^11.16.2",
    "sharp": "^0.35.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0"
  },
  "allowScripts": {
    "esbuild": true
  }
