---
import '../styles/styles.css';
import Nav from '../components/Nav.astro';
import Work from '../components/Work.astro';
import About from '../components/About.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import Lightbox from '../components/Lightbox.astro';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Roxane Foare',
  jobTitle: 'Video Editor',
  url: 'https://roxane-foare.com/',
  image: 'https://roxane-foare.com/og-image.jpg',
  sameAs: [],
  address: [
    { '@type': 'PostalAddress', addressLocality: 'Paris', addressCountry: 'FR' },
    { '@type': 'PostalAddress', addressLocality: 'Angers', addressCountry: 'FR' },
  ],
  knowsAbout: [
    'Film editing',
    'Documentary editing',
    'Commercial editing',
    'Corporate video',
    'Live broadcast',
    'Post-production',
  ],
  knowsLanguage: ['fr', 'en'],
};
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#fafaf8" />

  <title>Roxane Foare — Video Editor · Paris &amp; Angers</title>
  <meta name="description" content="Roxane Foare — freelance video editor based in Paris &amp; Angers. Film, documentary, commercial, corporate, live and event editing." />
  <meta name="keywords" content="video editor Paris, freelance editor France, film editing, documentary editing, commercial editing, post-production Paris, monteuse vidéo, monteur vidéo, montage Paris" />
  <meta name="author" content="Roxane Foare" />

  <link rel="canonical" href="https://roxane-foare.com/" />

  <!-- Favicons -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/favicon.png" />

  <!-- Open Graph -->
  <meta property="og:title" content="Roxane Foare — Video Editor" />
  <meta property="og:description" content="Freelance video editor specialised in film, documentary, corporate, commercial, live &amp; events." />
  <meta property="og:image" content="https://roxane-foare.com/og-image.jpg" />
  <meta property="og:url" content="https://roxane-foare.com/" />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="en_US" />
  <meta property="og:site_name" content="Roxane Foare" />

  <!-- Twitter / X Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Roxane Foare — Video Editor" />
  <meta name="twitter:description" content="Freelance video editor — film, documentary, corporate, commercial, live &amp; events." />
  <meta name="twitter:image" content="https://roxane-foare.com/og-image.jpg" />

  <!-- Géolocalisation -->
  <meta name="geo.region" content="FR-IDF" />
  <meta name="geo.placename" content="Paris, France" />

  <!-- Préchargement des ressources critiques -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" as="font" type="font/woff2" href="/HennessySerif1765.woff2" crossorigin />
  <link rel="preload" as="font" type="font/woff2" href="/DalaFloda-Roman.woff2" crossorigin />

  <!-- Google Fonts : DM Sans -->
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500&amp;display=swap" />

  <!-- Netlify Identity — redirection post-login vers /admin -->
  <script defer is:inline src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
  <script defer is:inline>
    window.addEventListener('load', () => {
      if (window.netlifyIdentity) {
        window.netlifyIdentity.on('init', (user) => {
          if (!user) {
            window.netlifyIdentity.on('login', () => { document.location.href = '/admin/'; });
          }
        });
      }
    });
  </script>

  <!-- Analytics Umami (privacy-friendly, sans cookies) -->
  <script defer is:inline src="https://cloud.umami.is/script.js" data-website-id="f751e82f-e6c9-4cdf-a93f-89629f170b29"></script>

  <!-- JSON-LD structured data -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
</head>
<body>
  <Nav />
  <Work />
  <About />
  <Contact />
  <Footer />
  <Lightbox />

  <script>
    import '../scripts/app.js';
  </script>
</body>
</html>
