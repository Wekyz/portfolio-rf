---
import '../styles/styles.css';
import Nav from '../components/Nav.astro';
import Work from '../components/Work.astro';
import About from '../components/About.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import Lightbox from '../components/Lightbox.astro';
import data from '../data/videos.json';
import { computeSpans } from '../lib/spans.js';

const SITE = 'https://roxane-foare.com';
const projects = data.videos || data;

// - Préchargement de l'image LCP (1ʳᵉ vignette), variante responsive incluse -
const spans = computeSpans(
  projects.map((p) => ({ cat: p.cat, fullWidth: p.fullWidth, portrait: p.portrait }))
);
const first = projects[0];
const firstThumb = first?.thumb
  ? (first.thumb.startsWith('/') ? first.thumb : `/${first.thumb}`)
  : (first?.id ? `/thumbs/${first.id}.webp` : null);
const firstIsWebp = !!firstThumb && firstThumb.endsWith('.webp');
const firstSrcset = firstIsWebp
  ? `${firstThumb.replace(/\.webp$/, '-640.webp')} 640w, ${firstThumb} 1280w`
  : undefined;
const firstSpanMatch = /span (\d+)/.exec(spans[0] || '');
const firstSpanN = firstSpanMatch ? Number(firstSpanMatch[1]) : 6;
const firstSizes = `(max-width: 900px) 100vw, ${Math.round((firstSpanN / 12) * 100)}vw`;

// - Données structurées VideoObject (rich results) pour les projets Vimeo -
const abs = (p) =>
  `${SITE}${p.thumb ? (p.thumb.startsWith('/') ? p.thumb : '/' + p.thumb) : '/thumbs/' + p.id + '.webp'}`;
const videoLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: projects
    .filter((p) => p.id && /^\d{4}$/.test(p.year || ''))
    .map((p, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'VideoObject',
        name: p.title,
        description: p.credit || p.title,
        thumbnailUrl: abs(p),
        uploadDate: `${p.year}-01-01`,
        embedUrl: `https://player.vimeo.com/video/${p.id}${p.hash ? `?h=${p.hash}` : ''}`,
      },
    })),
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Roxane Foare',
  jobTitle: 'Video Editor',
  url: 'https://roxane-foare.com/',
  image: 'https://roxane-foare.com/og-image.jpg',
  sameAs: [],
  address: [
    { '@type': 'PostalAddress', addressLocality: 'Paris', addressCountry: 'FR' },
    { '@type': 'PostalAddress', addressLocality: 'Angers', addressCountry: 'FR' },
  ],
  knowsAbout: [
    'Film editing',
    'Documentary editing',
    'Commercial editing',
    'Corporate video',
    'Live broadcast',
    'Post-production',
  ],
  knowsLanguage: ['fr', 'en'],
};
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#fafaf8" />

  <title>Roxane Foare - Video Editor · Paris &amp; Angers</title>
  <meta name="description" content="Roxane Foare - freelance video editor based in Paris &amp; Angers. Film, documentary, commercial, corporate, live and event editing." />
  <meta name="keywords" content="video editor Paris, freelance editor France, film editing, documentary editing, commercial editing, post-production Paris, monteuse vidéo, monteur vidéo, montage Paris" />
  <meta name="author" content="Roxane Foare" />

  <link rel="canonical" href="https://roxane-foare.com/" />

  <!-- Favicons -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/favicon.png" />

  <!-- Open Graph -->
  <meta property="og:title" content="Roxane Foare - Video Editor" />
  <meta property="og:description" content="Freelance video editor specialised in film, documentary, corporate, commercial, live &amp; events." />
  <meta property="og:image" content="https://roxane-foare.com/og-image.jpg" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Roxane Foare - Video Editor" />
  <meta property="og:url" content="https://roxane-foare.com/" />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="en_US" />
  <meta property="og:site_name" content="Roxane Foare" />

  <!-- Twitter / X Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Roxane Foare - Video Editor" />
  <meta name="twitter:description" content="Freelance video editor - film, documentary, corporate, commercial, live &amp; events." />
  <meta name="twitter:image" content="https://roxane-foare.com/og-image.jpg" />

  <!-- Géolocalisation -->
  <meta name="geo.region" content="FR-IDF" />
  <meta name="geo.placename" content="Paris, France" />

  <!-- Préchargement des polices critiques (toutes auto-hébergées) -->
  <link rel="preload" as="font" type="font/woff2" href="/HennessySerif1765.woff2" crossorigin />
  <link rel="preload" as="font" type="font/woff2" href="/DalaFloda-Roman.woff2" crossorigin />
  <link rel="preload" as="font" type="font/woff2" href="/DMSans-latin.woff2" crossorigin />

  <!-- Préchargement de l'image LCP (1ʳᵉ vignette) -->
  {firstThumb && (
    <link
      rel="preload"
      as="image"
      href={firstThumb}
      imagesrcset={firstSrcset}
      imagesizes={firstSizes}
      fetchpriority="high"
    />
  )}

  <!-- Vercel Web Analytics (servi en same-origin par Vercel : /_vercel/insights) -->
  <script defer is:inline src="/_vercel/insights/script.js"></script>

  <!-- JSON-LD structured data -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  {videoLd.itemListElement.length > 0 && (
    <script type="application/ld+json" is:inline set:html={JSON.stringify(videoLd)} />
  )}
</head>
<body>
  <a href="#main" class="skip-link">Skip to content</a>
  <Nav />
  <main id="main">
    <Work />
    <About />
    <Contact />
  </main>
  <Footer />
  <Lightbox />

  <script>
    import '../scripts/app.js';
  </script>
</body>
</html>
