---
// Lecteur vidéo Vimeo (modale)
---
<div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Video player">
  <div class="lightbox-inner">
    <button type="button" class="lightbox-close" id="lightboxClose" aria-label="Close video">&times;</button>
    <iframe id="lightboxFrame" src="" title="Vimeo video player" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>
  </div>
</div>
