---
// Section Contact + formulaire (envoyé via la fonction /api/contact -> Resend)
---
<section id="contact">
  <div class="contact-left">
    <h2 class="section-title">Contact</h2>
    <p class="contact-tagline">Let's work<br><em>together</em></p>
    <p class="contact-desc">Open to new projects. I would be delighted to discuss your ideas and bring them to life.</p>
    <div class="contact-links">
      <a href="/api/email" class="contact-link" id="email-link">
        <span class="contact-link-arrow" aria-hidden="true"></span>
        <span>Send me an email</span>
      </a>
    </div>
  </div>

  <form class="contact-form" name="contact" method="POST" action="/api/contact">
    <p class="hp-field" aria-hidden="true">
      <label>Don't fill this out: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
    </p>

    <div class="form-row">
      <div class="form-group">
        <label for="first-name">First name</label>
        <input id="first-name" type="text" name="first-name" placeholder="Marie" autocomplete="given-name" required />
      </div>
      <div class="form-group">
        <label for="last-name">Last name</label>
        <input id="last-name" type="text" name="last-name" placeholder="Dupont" autocomplete="family-name" required />
      </div>
    </div>

    <div class="form-group">
      <label for="email">Email</label>
      <input id="email" type="email" name="email" placeholder="marie@studio.com" autocomplete="email" required />
    </div>

    <div class="form-group">
      <label for="message">Message</label>
      <textarea id="message" name="message" rows="5" placeholder="Tell me about your project…"></textarea>
    </div>

    <button type="submit" class="form-submit">
      Send
      <svg width="16" height="10" viewBox="0 0 16 10" fill="none" aria-hidden="true">
        <path d="M0 5H14M10 1L14 5L10 9" stroke="white" stroke-width="1.2"/>
      </svg>
    </button>
  </form>
</section>
