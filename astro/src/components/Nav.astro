---
// Barre de navigation
import { useTranslations } from '../i18n/strings.js';
const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
// Lien du toggle : depuis EN on pointe vers /fr, depuis FR vers /.
const otherHref = lang === 'fr' ? '/' : '/fr';
---
<nav>
  <h1 class="nav-logo-h1">
    <a href={lang === 'fr' ? '/fr' : '/'} class="nav-logo">
      Roxane Foare
      <span class="nav-logo-sub">{t('nav.sub')}</span>
    </a>
  </h1>
  <ul class="nav-links">
    <li><a class="slide-label" href="#work"><span class="lbl-out">{t('nav.work')}</span><span class="lbl-in" aria-hidden="true">{t('nav.work')}</span></a></li>
    <li><a class="slide-label" href="#about"><span class="lbl-out">{t('nav.about')}</span><span class="lbl-in" aria-hidden="true">{t('nav.about')}</span></a></li>
    <li><a class="slide-label" href="#contact"><span class="lbl-out">{t('nav.contact')}</span><span class="lbl-in" aria-hidden="true">{t('nav.contact')}</span></a></li>
    <li><a class="nav-lang" href={otherHref} aria-label={t('nav.langAria')}>{t('nav.langLabel')}</a></li>
  </ul>
</nav>
