---
/**
 * Une vignette de la grille Work. Rendu au build (équivalent de buildItem()
 * dans l'ancien app.js). La valeur grid-column est calculée en amont et
 * passée via la prop `gridColumn`.
 */

const CAT_LABELS = {
  film: 'Feature Film',
  pub: 'Commercial',
  doc: 'Documentary',
  corpo: 'Corporate',
  event: 'Event',
  teaser: 'Teaser',
  live: 'Live',
};

const { project, gridColumn } = Astro.props;
const p = project;

const interactive = !p.noClick && (p.id || p.externalLink);
const prod = p.credit || CAT_LABELS[p.cat] || p.cat;
const imgWidth = p.portrait ? 600 : 1280;
const imgHeight = p.portrait ? 900 : 800;
// Source de la miniature :
//  1. champ `thumb` s'il est renseigné (tolère avec ou sans "/" initial) ;
//  2. sinon, fallback auto sur /thumbs/<id>.webp (générée au build depuis Vimeo).
// La monteuse peut donc ne saisir que l'ID Vimeo : la miniature suit.
const thumbSrc = p.thumb
  ? (p.thumb.startsWith('/') ? p.thumb : `/${p.thumb}`)
  : (p.id ? `/thumbs/${p.id}.webp` : null);
---

<div
  class="work-item"
  data-cat={p.cat}
  data-id={p.id || ''}
  data-hash={p.hash || ''}
  data-external={p.externalLink || ''}
  data-full-width={p.fullWidth ? 'true' : ''}
  data-portrait={p.portrait ? 'true' : ''}
  style={`grid-column: ${gridColumn}`}
>
  {interactive ? (
    <button type="button" class="work-thumb-wrap" aria-label={`Watch — ${p.title}`}>
      {thumbSrc && (
        <img
          class="work-thumb"
          src={thumbSrc}
          alt={p.title}
          loading="lazy"
          decoding="async"
          width={imgWidth}
          height={imgHeight}
        />
      )}
      <div class="work-overlay">
        <div class="work-play">
          {p.externalLink ? (
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
              <path
                d="M7 3H3a1 1 0 00-1 1v11a1 1 0 001 1h11a1 1 0 001-1v-4M10 2h6v6M15 3l-7 7"
                stroke="white"
                stroke-width="1.4"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          ) : (
            <svg width="14" height="16" viewBox="0 0 14 16" fill="none" aria-hidden="true">
              <path d="M1 1L13 8L1 15V1Z" fill="white" />
            </svg>
          )}
        </div>
        <div class="work-info">
          <div class="work-title">{p.title}</div>
          <div class="work-meta"><span class="work-prod">{prod}</span></div>
          {p.externalLink && <span class="work-badge">Watch &rarr;</span>}
        </div>
      </div>
    </button>
  ) : (
    <div class="work-thumb-wrap">
      {thumbSrc && (
        <img
          class="work-thumb"
          src={thumbSrc}
          alt={p.title}
          loading="lazy"
          decoding="async"
          width={imgWidth}
          height={imgHeight}
        />
      )}
      <div class="work-overlay">
        <div class="work-play">
          <svg width="14" height="16" viewBox="0 0 14 16" fill="none" aria-hidden="true">
            <path d="M1 1L13 8L1 15V1Z" fill="white" />
          </svg>
        </div>
        <div class="work-info">
          <div class="work-title">{p.title}</div>
          <div class="work-meta"><span class="work-prod">{prod}</span></div>
        </div>
      </div>
    </div>
  )}
</div>
