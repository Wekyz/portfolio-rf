---
/**
 * Page projet (EN) - une par vidéo Vimeo, générée au build.
 *
 * Coexiste avec src/pages/portfolio.astro : Astro sert /portfolio depuis le
 * fichier, et /portfolio/<slug> depuis cette route dynamique.
 */
import Base from '../../layouts/Base.astro';
import ProjectDetail from '../../components/ProjectDetail.astro';
import Contact from '../../components/Contact.astro';
import { projectRoutes } from '../../lib/slug.js';
import { getProjects } from '../../lib/projects.js';
import { buildProjectMeta, relatedProjects, siblingProjects, buildBreadcrumb } from '../../lib/project-page.js';

export function getStaticPaths() {
  const routes = projectRoutes(getProjects());
  return routes.map(({ project, slug }) => ({
    params: { slug },
    props: {
      project,
      slug,
      related: relatedProjects(project, routes),
      siblings: siblingProjects(project, routes),
    },
  }));
}

const { project, slug, related, siblings } = Astro.props;
const meta = buildProjectMeta(project, slug, 'en');
---
<Base lang="en" page="project" {...meta} breadcrumb={buildBreadcrumb(project, 'en', slug)}>
  <ProjectDetail project={project} related={related} siblings={siblings} lang="en" />
  <Contact lang="en" />
</Base>
