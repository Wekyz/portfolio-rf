---
/**
 * Page projet (EN) - une par vidéo Vimeo, générée au build.
 *
 * Coexiste avec src/pages/portfolio.astro : Astro sert /portfolio depuis le
 * fichier, et /portfolio/<slug> depuis cette route dynamique.
 */
import Base from '../../layouts/Base.astro';
import ProjectDetail from '../../components/ProjectDetail.astro';
import Contact from '../../components/Contact.astro';
import data from '../../data/videos.json';
import { projectRoutes } from '../../lib/slug.js';
import { buildProjectMeta, relatedProjects, buildBreadcrumb } from '../../lib/project-page.js';
import type { Project } from '../../lib/types';

export function getStaticPaths() {
  const routes = projectRoutes((data.videos || data) as Project[]);
  return routes.map(({ project, slug }) => ({
    params: { slug },
    props: { project, slug, related: relatedProjects(project, routes) },
  }));
}

const { project, slug, related } = Astro.props;
const meta = buildProjectMeta(project, slug, 'en');
---
<Base lang="en" page="project" {...meta} breadcrumb={buildBreadcrumb(project, 'en')}>
  <ProjectDetail project={project} related={related} lang="en" />
  <Contact lang="en" />
</Base>
