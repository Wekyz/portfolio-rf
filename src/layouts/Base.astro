---
import { createHash } from 'node:crypto';
import '../styles/styles.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Lightbox from '../components/Lightbox.astro';
import BackToTop from '../components/BackToTop.astro';
import data from '../data/videos.json';
import { computeSpans } from '../lib/spans.js';
import { resolveThumb } from '../lib/thumb.js';
import { buildSlugMap } from '../lib/slug.js';
import { useTranslations } from '../i18n/strings.js';
import type { Project } from '../lib/types';

// `page` détermine le head (title/description/canonical/JSON-LD) et le
// routage - voir plus bas. 'portfolio' est la seule page à embarquer la
// grille de projets (preload LCP de la 1ère vignette).
//
// Les pages projet (/portfolio/[slug]) ne peuvent pas dériver leur head des
// traductions : leur titre dépend du projet. Elles passent donc `path`,
// `title`, `description`, `keywords` et `videoObject` explicitement. Le
// comportement des 3 pages fixes est inchangé quand ces props sont absentes.
const {
  lang = 'en',
  page = 'home',
  path,
  title,
  description,
  keywords,
  ogImage,
  videoObject,
  breadcrumb,
} = Astro.props;
const t = useTranslations(lang);

const SITE = 'https://roxane-foare.com';
const langBase = lang === 'fr' ? '/fr' : '';
const pagePath = path ?? (page === 'home' ? '' : `/${page}`);
const canonical = `${SITE}${langBase}${pagePath}` || `${SITE}/`;
const enHref = `${SITE}${pagePath || '/'}`;
const frHref = `${SITE}/fr${pagePath}`;

const pageTitle = title ?? t(`head.${page}.title`);
const pageDescription = description ?? t(`head.${page}.description`);
const pageKeywords = keywords ?? t(`head.${page}.keywords`);
const ogImageUrl = ogImage ?? `${SITE}/og-image.jpg`;

const projects = (data.videos || data) as Project[];
const isPortfolio = page === 'portfolio';

// - Préchargement de l'image LCP (1ʳᵉ vignette) : seulement pertinent sur la
//   page Portfolio, où la grille est le 1er contenu visuel de la page. -
const spans = isPortfolio
  ? computeSpans(projects.map((p) => ({ cat: p.cat, fullWidth: p.fullWidth, portrait: p.portrait })))
  : [];
const first = isPortfolio ? projects[0] : null;
const firstThumbResolved = first ? resolveThumb(first) : null;
const firstThumb = firstThumbResolved?.src ?? null;
const firstSrcset = firstThumbResolved?.srcset;
const firstSpanN = spans[0]?.span ?? 6;
const firstSizes = `(max-width: 900px) 100vw, ${Math.round((firstSpanN / 12) * 100)}vw`;

// - Données structurées de la page Portfolio -------------------------------
// Une ItemList qui pointe vers les pages projet, et rien de plus.
//
// Elle contenait auparavant un VideoObject par projet, appuyé sur 31 iframes
// Vimeo cachés dans la grille. Mesuré le 2026-08-06 : ces iframes ne se
// chargeaient jamais (leur conteneur, clippé à 0x0, empêchait le `loading=
// "lazy"` de se déclencher) et Search Console n'indexait aucune des 31
// vidéos. Google exige un lecteur réellement visible sur la page qui déclare
// le VideoObject : hauteur > 140 px, largeur > 140 px et au moins un tiers de
// la page, dans la zone rendue au chargement. C'est désormais chaque page
// projet qui porte son propre VideoObject, avec un vrai lecteur en tête.
const listLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: [...buildSlugMap(isPortfolio ? projects : [])].map(([p, slug], i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `${SITE}${langBase}/portfolio/${slug}`,
    name: p.title,
  })),
};

// La page projet fournit son propre VideoObject ; sinon on retombe sur
// l'ItemList du portfolio. Les autres pages n'ont ni l'un ni l'autre. Le fil
// d'Ariane, lui, ne concerne que les pages projet (seules à être imbriquées).
const secondaryLd = videoObject ?? (listLd.itemListElement.length > 0 ? listLd : null);

// Identité de Roxane (Person) : présente sur les 3 pages, chacune est un
// point d'entrée valable pour les moteurs et les agents.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Roxane Foare',
  jobTitle: t('head.jobTitle'),
  url: canonical,
  image: `${SITE}/og-image.jpg`,
  sameAs: ['https://www.imdb.com/fr/name/nm8663077/'],
  address: [
    { '@type': 'PostalAddress', addressLocality: 'Paris', addressCountry: 'FR' },
    { '@type': 'PostalAddress', addressLocality: 'Angers', addressCountry: 'FR' },
  ],
  knowsAbout: [
    'Film editing',
    'Documentary editing',
    'Commercial editing',
    'Corporate video',
    'Live broadcast',
    'Post-production',
  ],
  knowsLanguage: ['fr', 'en'],
};

// - CSP : hash des scripts JSON-LD ci-dessous ------------------------------
// Leur contenu vient de `videos.json` (édité via le CMS) et des traductions,
// donc Astro ne peut pas le connaître à la compilation (contrairement au
// script client, qu'il hash automatiquement) : on calcule et on déclare
// nous-mêmes le hash SHA-256 exact du contenu rendu, recalculé à chaque
// build - donc à chaque modification de contenu via le CMS.
// Le type de retour est volontairement le littéral `sha256-${string}` et non
// `string` : c'est la forme exacte qu'attend Astro.csp.insertScriptHash
// (type CspHashEntry), qui refuse une chaîne quelconque.
//
// Les deux balises correspondantes plus bas portent `is:inline`. Ça ne change
// rien au rendu - Astro les traite déjà ainsi puisqu'elles ont un attribut
// `type` qu'il ne prend pas en charge (vérifié : sortie identique octet pour
// octet, mêmes hashes CSP) - mais ça déclare l'intention : ces scripts ne
// doivent surtout pas être bundlés ni transpilés, sinon leur contenu ne
// correspondrait plus au hash calculé ici.
function sha256(content: string): `sha256-${string}` {
  return `sha256-${createHash('sha256').update(content, 'utf8').digest('base64')}`;
}
// Person (partout), puis selon la page : ItemList du portfolio ou VideoObject
// du projet, et le fil d'Ariane des pages projet. Chaque bloc a son propre
// hash CSP.
const ldBlocks = [jsonLd, secondaryLd, breadcrumb]
  .filter(Boolean)
  .map((block) => JSON.stringify(block).replace(/</g, '\\u003c'));
ldBlocks.forEach((block) => Astro.csp?.insertScriptHash(sha256(block)));
---
<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#fafaf8" />

  <title>{pageTitle}</title>
  <meta name="description" content={pageDescription} />
  <meta name="keywords" content={pageKeywords} />
  <meta name="author" content="Roxane Foare" />

  <link rel="canonical" href={canonical} />

  <!-- Versions linguistiques (hreflang), pour cette page précisément -->
  <link rel="alternate" hreflang="en" href={enHref} />
  <link rel="alternate" hreflang="fr" href={frHref} />
  <link rel="alternate" hreflang="x-default" href={enHref} />

  <!-- Favicons -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/favicon.png" />

  <!-- Open Graph -->
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDescription} />
  <meta property="og:image" content={ogImageUrl} />
  {!ogImage && <meta property="og:image:width" content="1200" />}
  {!ogImage && <meta property="og:image:height" content="630" />}
  <meta property="og:image:alt" content={t('head.ogImageAlt')} />
  <meta property="og:logo" content={`${SITE}/favicon.png`} />
  <meta property="og:url" content={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content={t('head.ogLocale')} />
  <meta property="og:locale:alternate" content={lang === 'fr' ? 'en_US' : 'fr_FR'} />
  <meta property="og:site_name" content="Roxane Foare" />

  <!-- Twitter / X Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={pageDescription} />
  <meta name="twitter:image" content={ogImageUrl} />

  <!-- Géolocalisation -->
  <meta name="geo.region" content="FR-IDF" />
  <meta name="geo.placename" content="Paris, France" />

  <!-- Préchargement des polices critiques (toutes auto-hébergées) -->
  <link rel="preload" as="font" type="font/woff2" href="/HennessySerif1765.woff2" crossorigin />
  <link rel="preload" as="font" type="font/woff2" href="/DalaFloda-Roman.woff2" crossorigin />
  <link rel="preload" as="font" type="font/woff2" href="/DMSans-latin.woff2" crossorigin />

  <!-- Connexion anticipée vers Vimeo : le showreel (Accueil), la grille +
       lightbox (Portfolio) en dépendent toutes deux. -->
  <link rel="preconnect" href="https://i.vimeocdn.com" />
  <link rel="preconnect" href="https://player.vimeo.com" />

  <!-- Préchargement de l'image LCP (1ʳᵉ vignette, page Portfolio uniquement) -->
  {firstThumb && (
    <link
      rel="preload"
      as="image"
      href={firstThumb}
      imagesrcset={firstSrcset}
      imagesizes={firstSizes}
      fetchpriority="high"
    />
  )}

  <!-- Vercel Web Analytics (servi en same-origin par Vercel : /_vercel/insights) -->
  <script defer is:inline src="/_vercel/insights/script.js"></script>

  <!-- JSON-LD structured data (contenu + hash CSP calculés ci-dessus) -->
  {ldBlocks.map((block) => (
    <script is:inline type="application/ld+json" set:html={block} />
  ))}
</head>
<body>
  <a href="#main" class="skip-link">{t('a11y.skip')}</a>
  <Nav lang={lang} page={page} path={pagePath} />
  <main id="main">
    <slot />
  </main>
  <Footer lang={lang} />
  <Lightbox lang={lang} />
  {page !== 'home' && <BackToTop lang={lang} />}

  <script>
    import '../scripts/app.js';
  </script>
</body>
</html>
