---
/**
 * FAQ - accordéon discret en bas de la page À propos.
 *
 * Volontairement replié : les questions restent visibles, les réponses ne
 * s'ouvrent qu'au clic. `<details>` natif plutôt que du JavaScript - le
 * contenu est dans le HTML même sans script, donc lisible par les moteurs et
 * les agents, qui sont la raison d'être de cette section (voir i18n/faq.js).
 */
import { faq } from '../i18n/faq.js';
import { useTranslations } from '../i18n/strings.js';

interface Props {
  lang?: 'en' | 'fr';
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
---
<section class="faq credits-block">
  <h2 class="credits-heading">{t('faq.title')}</h2>
  <div class="faq-list">
    {faq[lang].map((item) => (
      <details class="faq-item">
        <summary>{item.q}</summary>
        <p>{item.a}</p>
      </details>
    ))}
  </div>
</section>
