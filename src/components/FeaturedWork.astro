---
/**
 * Projets mis en avant sur la page d'accueil.
 *
 * La sélection se fait depuis le CMS : chaque projet porte une case « Mettre
 * en avant sur l'accueil » (champ `featured`). La monteuse peut donc changer
 * la vitrine quand elle veut, sans intervention technique.
 *
 * Le choix et l'ordre des projets retenus sont dans lib/featured.js.
 *
 * La section n'existe QUE s'il y a une sélection : tant qu'aucun projet n'est
 * coché, l'accueil se limite au showreel. Il y avait auparavant un repli sur
 * les trois premiers de la liste, pour ne jamais montrer un blanc - mais il
 * affichait une vitrine que personne n'avait choisie, indiscernable d'une
 * sélection voulue. Mieux vaut pas de section qu'une section arbitraire.
 *
 * Un projet est retenu s'il mène quelque part : sa page (donc une vidéo
 * Vimeo) ou, à défaut, son lien externe, ouvert dans un nouvel onglet. Le
 * long métrage n'a plus de vidéo Vimeo, seulement son lien Prime Video :
 * coché dans le CMS, il n'apparaissait pas sur l'accueil (octobre 2026).
 * Une vignette sans page ni lien reste écartée.
 */
import { useTranslations } from '../i18n/strings.js';
import { resolveThumb } from '../lib/thumb.js';
import { localImages } from '../lib/images.js';
import Thumb from './Thumb.astro';
import { buildSlugMap } from '../lib/slug.js';
import { getProjects } from '../lib/projects.js';
import { creditLine } from '../lib/credits.js';
import { selectFeatured } from '../lib/featured.js';

interface Props {
  lang?: 'en' | 'fr';
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
const langBase = lang === 'fr' ? '/fr' : '';

const LIMIT = 3;
const projects = getProjects();
const slugMap = buildSlugMap(projects);

const featured = selectFeatured(projects, (p) => slugMap.has(p), LIMIT);
---
{featured.length > 0 && (
  <section class="featured">
    <div class="featured-head">
      <h2 class="featured-title">{t('featured.title')}</h2>
      <a class="featured-all" href={`${langBase}/portfolio`}>{t('featured.all')} &rarr;</a>
    </div>

    <ul class="featured-grid">
      {featured.map((p, i) => {
        // `featuredThumb` remplace la miniature ici seulement : le cadre 16/10
        // de la sélection coupait le triptyque du long métrage, montré en
        // entier dans la grille du portfolio.
        const thumbSource = p.featuredThumb ? { ...p, thumb: p.featuredThumb } : p;
        const { src, srcset, avifSrcset } = resolveThumb(thumbSource, { local: localImages });
        const slug = slugMap.get(p);
        const link = slug
          ? { href: `${langBase}/portfolio/${slug}` }
          : { href: p.externalLink, target: '_blank', rel: 'noopener noreferrer' };
        return (
          <li>
            <a {...link}>
              {src && (
                <Thumb
                  src={src}
                  srcset={srcset}
                  avifSrcset={avifSrcset}
                  sizes="(max-width: 900px) 100vw, calc((100vw - 160px) / 3)"
                  alt={p.title}
                  loading={i === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                  width="1280"
                  height="800"
                />
              )}
              <span class="featured-name">{p.title}</span>
              <span class="featured-meta">
                {[creditLine(p, lang), p.year].filter(Boolean).join(' · ')}
              </span>
            </a>
          </li>
        );
      })}
    </ul>
  </section>
)}
