---
// Barre de navigation - commune à toutes les pages.
// Menu burger sur mobile (voir app.js pour le toggle).
import { useTranslations } from '../i18n/strings.js';
const { lang = 'en', page = 'home', path } = Astro.props;
const t = useTranslations(lang);

const base = lang === 'fr' ? '/fr' : '';
const homeHref = base || '/';
const portfolioHref = `${base}/portfolio`;
const aboutHref = `${base}/about`;
const contactHref = page === 'home' ? `${portfolioHref}#contact` : '#contact';

// Bascule de langue : sur le chemin réel, et non plus déduit de `page`. Les
// pages projet ont un chemin à deux segments (/portfolio/[slug]) qui n'est pas
// dérivable du nom de page - `path` est fourni par Base.astro.
const currentPath = path ?? (page === 'home' ? '' : `/${page}`);
const otherHref = lang === 'fr' ? currentPath || '/' : `/fr${currentPath}`;
---
<nav class:list={[page === 'home' && 'nav-flush']}>
  <!-- Le logo n'est PAS un H1 : il est identique sur toutes les pages, alors
       que le H1 doit annoncer le contenu propre à chacune. L'identité de
       Roxane est déjà portée par le <title>, le domaine et le JSON-LD Person.
       Chaque page pose son propre H1 (tagline, Portfolio, À propos, titre du
       projet). -->
  <div class="nav-logo-wrap">
    <a href={homeHref} class="nav-logo">
      Roxane Foare
      <span class="nav-logo-sub">{t('nav.sub')}</span>
    </a>
  </div>
  <button type="button" class="nav-burger" id="navBurger" aria-expanded="false" aria-controls="navLinks" aria-label={t('nav.menuAria')}>
    <span></span><span></span><span></span>
  </button>
  <ul class="nav-links" id="navLinks">
    <li><a class="slide-label" href={portfolioHref} aria-current={page === 'portfolio' ? 'page' : undefined}><span class="lbl-out">{t('nav.work')}</span><span class="lbl-in" aria-hidden="true">{t('nav.work')}</span></a></li>
    <li><a class="slide-label" href={aboutHref} aria-current={page === 'about' ? 'page' : undefined}><span class="lbl-out">{t('nav.about')}</span><span class="lbl-in" aria-hidden="true">{t('nav.about')}</span></a></li>
    <li><a class="slide-label" href={contactHref}><span class="lbl-out">{t('nav.contact')}</span><span class="lbl-in" aria-hidden="true">{t('nav.contact')}</span></a></li>
    <li><a class="nav-lang" href={otherHref} aria-label={t('nav.langAria')}>{t('nav.langLabel')}</a></li>
  </ul>
</nav>
