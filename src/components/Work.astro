---
import data from '../data/videos.json';
import { computeSpans } from '../lib/spans.js';
import WorkItem from './WorkItem.astro';
import { useTranslations } from '../i18n/strings.js';
import { buildSlugMap } from '../lib/slug.js';
import type { Category, Project } from '../lib/types';

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);

const projects = (data.videos || data) as Project[];

// Destination de chaque vignette. Les slugs sont calculés ici, sur la liste
// complète : leur unicité en dépend (voir lib/slug.js). Un projet sans vidéo
// Vimeo n'a pas de page ; s'il porte un lien externe, la vignette pointe
// directement dessus.
const slugMap = buildSlugMap(projects);
const langBase = lang === 'fr' ? '/fr' : '';
const hrefFor = (p: Project) => {
  const slug = slugMap.get(p);
  if (slug) return `${langBase}/portfolio/${slug}`;
  return p.externalLink || undefined;
};

// Pré-calcul des grid-column au build (même résultat que l'ancien applySpans
// au chargement, mais sans flash ni recalcul JS au premier rendu).
const spans = computeSpans(
  projects.map((p) => ({ cat: p.cat, fullWidth: p.fullWidth, portrait: p.portrait }))
);

const FILTERS = ['pub', 'film', 'doc', 'corpo', 'event', 'teaser', 'live'];
const ALL_FILTERS = ['all', ...FILTERS];

// Un séparateur de section (titre centré) en tête de chaque catégorie -
// l'ordre de videos.json est déjà groupé par catégorie (même ordre que
// FILTERS ci-dessus), donc un simple suivi de la catégorie précédente suffit
// à détecter les 7 changements de section.
let lastCat: Category | null = null;
const gridEntries = projects.map((p, i) => {
  const isNewCat = p.cat !== lastCat;
  lastCat = p.cat;
  return { project: p, placement: spans[i], isNewCat };
});
---
<section id="work">
  <div class="section-header">
    <h2 class="section-title">{t('work.title')}</h2>
    <span class="section-location">{t('work.location')}</span>
  </div>

  <!-- Boutons (desktop/tablette) -->
  <div class="filters" role="group" aria-label={t('work.filterAria')}>
    {ALL_FILTERS.map((value, i) => (
      <>
        {i > 0 && <span class="filter-sep" aria-hidden="true">//</span>}
        <button class="filter-btn slide-label" data-filter={value}>
          <span class="lbl-out">{t(`cat.${value}`)}</span>
          <span class="lbl-in" aria-hidden="true">{t(`cat.${value}`)}</span>
        </button>
      </>
    ))}
  </div>

  <!-- Menu déroulant (mobile) - même liste, voir app.js pour la synchro -->
  <div class="filter-select-wrap">
    <label class="visually-hidden" for="filterSelect">{t('work.filterAria')}</label>
    <select class="filter-select" id="filterSelect">
      {ALL_FILTERS.map((value) => (
        <option value={value}>{t(`cat.${value}`)}</option>
      ))}
    </select>
  </div>

  <div class="work-grid" id="workGrid">
    {gridEntries.map(({ project: p, placement, isNewCat }, i) => (
      <>
        {isNewCat && (
          <div class="cat-divider" data-cat={p.cat}>
            <span class="cat-divider-line" aria-hidden="true"></span>
            <h3 class="cat-divider-title">{t(`cat.${p.cat}`)}</h3>
            <span class="cat-divider-line" aria-hidden="true"></span>
          </div>
        )}
        <WorkItem project={p} placement={placement} priority={i < 3} lang={lang} href={hrefFor(p)} />
      </>
    ))}
  </div>
</section>
