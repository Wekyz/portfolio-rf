---
// Section Accueil : showreel Vimeo en boucle (format cinéma 1920×803) + CTA
// vers les pages Portfolio et About.
import { useTranslations } from '../i18n/strings.js';
const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
const base = lang === 'fr' ? '/fr' : '';

// Showreel Vimeo (vidéo privée : hash requis). `background=1` demande à
// Vimeo la lecture en boucle, muette, sans aucune UI. Le "cover" (remplir
// le cadre sans bande noire, quel que soit le ratio du conteneur) n'est en
// revanche PAS fiable via ce mode sur un conteneur plus étroit que la vidéo
// (bandes noires constatées sur mobile) : on le refait nous-mêmes en CSS
// (.showreel-frame), voir le commentaire associé dans styles.css.
// Pas de `quality=1080p` : ce paramètre épinglait le rendu 1080p sur TOUS les
// écrans, y compris un mobile de 390 px de large où les pixels n'existent pas
// pour l'afficher - 45% des visiteurs. Sans lui, Vimeo sert son flux adaptatif
// et choisit la définition selon la taille du lecteur et le débit.
// Contrepartie : sur un grand écran, la définition peut monter en une seconde
// ou deux au lieu d'être maximale d'emblée.
// Accessibilité du conteneur : il portait un `role="img"` qui rendait ses
// descendants présentationnels pour les technologies d'assistance, alors que
// l'iframe restait atteignable au clavier - le focus pouvait donc atterrir
// dans un élément annoncé comme une simple image. Retiré : l'iframe porte
// déjà son propre `title`, qui suffit.
// `tabindex="-1"` : l'iframe elle-même reste hors du parcours clavier. En mode
// `background=1` le lecteur Vimeo n'affiche aucune commande, s'y arrêter ne
// mènerait nulle part - les commandes sont posées à côté, en HTML (voir
// `.showreel-controls` plus bas), et ce sont elles qui reçoivent le focus.
const VIMEO_ID = '1211961310';
const VIMEO_HASH = '33632a8dbb';
const embedSrc = `https://player.vimeo.com/video/${VIMEO_ID}?h=${VIMEO_HASH}&background=1&autoplay=1&loop=1&muted=1`;
---
<section id="hero" class="hero">
  <div class="showreel">
    <iframe
      class="showreel-frame"
      src={embedSrc}
      title={t('hero.showreelLabel')}
      allow="autoplay; fullscreen"
      loading="eager"
      tabindex="-1"
    ></iframe>
  </div>

  {/* Commandes du showreel. WCAG 2.2.2 : un contenu animé lancé
       automatiquement, de plus de cinq secondes, présenté à côté d'autres
       contenus, doit pouvoir être arrêté. Le bandeau de logos de la page À
       propos a reçu ce bouton ; le showreel, qui occupe toute la largeur et
       tourne indéfiniment, ne l'avait pas.

       Elles pilotent le lecteur par postMessage (voir app.js) : pas de SDK
       Vimeo à charger, aucun octet tiers de plus, et l'API répond bien en
       mode `background=1` (vérifié : pause, play et setCurrentTime).

       `hidden` au départ, retiré par app.js à la première réponse du lecteur.
       Un bouton de pause qui ne met rien en pause - JS en échec, lecteur
       injoignable - vaut moins que pas de bouton du tout.

       Le curseur est un `input[type=range]` natif : navigation clavier
       (flèches, Origine/Fin), rôle et valeur exposés, glisser tactile, le
       tout sans code. Son `max` devient la durée en secondes dès qu'elle est
       connue, de sorte qu'une flèche déplace d'une seconde. */}
  <div class="showreel-controls" id="showreelControls" hidden>
    <button
      type="button"
      class="media-toggle"
      id="showreelToggle"
      aria-pressed="false"
      data-label-pause={t('hero.pause')}
      data-label-play={t('hero.play')}
      aria-label={t('hero.pause')}
    >
      <svg class="icon-pause" width="10" height="12" viewBox="0 0 10 12" aria-hidden="true">
        <rect x="0" y="0" width="3" height="12" fill="currentColor" />
        <rect x="7" y="0" width="3" height="12" fill="currentColor" />
      </svg>
      <svg class="icon-play" width="10" height="12" viewBox="0 0 10 12" aria-hidden="true">
        <path d="M0 0L10 6L0 12Z" fill="currentColor" />
      </svg>
    </button>
    <input
      class="showreel-seek"
      id="showreelSeek"
      type="range"
      min="0"
      max="100"
      value="0"
      step="1"
      aria-label={t('hero.seek')}
    />
  </div>

  <div class="hero-content">
    {/* H1 de l'accueil : la tagline porte déjà les mots-clés utiles
         (monteuse vidéo, Paris, Angers, types de montage), là où le logo ne
         répétait que le nom de domaine. */}
    <h1 class="hero-tagline">{t('hero.tagline')}</h1>
    <div class="hero-cta">
      <a href={`${base}/portfolio`} class="hero-cta-btn hero-cta-primary">
        {t('hero.ctaPortfolio')}
        <svg width="16" height="10" viewBox="0 0 16 10" fill="none" aria-hidden="true">
          <path d="M0 5H14M10 1L14 5L10 9" stroke="currentColor" stroke-width="1.2"/>
        </svg>
      </a>
      <a href={`${base}/about`} class="hero-cta-btn hero-cta-secondary">{t('hero.ctaAbout')}</a>
    </div>
  </div>
</section>
