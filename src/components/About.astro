---
// Section About - Bio, outils, productions & marques (contenu statique)
import { useTranslations } from '../i18n/strings.js';
const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
const introParagraphs = t('about.introParagraphs');

// Logos clients (bandeau défilant) - fichiers pré-détourés/redimensionnés
// (voir public/brands/, générés depuis le dossier "Logos RF" fourni par la
// monteuse). width/height = dimensions réelles du fichier (hauteur commune
// 160px) : évite un saut de mise en page pendant le chargement, la taille
// d'affichage réelle est pilotée en CSS (.brand-logo img).
const BRANDS = [
  { slug: 'accor', name: 'Accor', width: 196, height: 160 },
  { slug: 'bnp', name: 'BNP Paribas', width: 722, height: 160 },
  { slug: 'bosch', name: 'Bosch', width: 143, height: 160 },
  { slug: 'carolina-herrera', name: 'Carolina Herrera', width: 2540, height: 160 },
  { slug: 'carrefour', name: 'Carrefour', width: 214, height: 160 },
  { slug: 'celio', name: 'Celio', width: 739, height: 160 },
  { slug: 'chaumet', name: 'Chaumet', width: 330, height: 160 },
  { slug: 'davidoff', name: 'Davidoff', width: 1296, height: 160 },
  { slug: 'estee-lauder', name: 'Estée Lauder', width: 1266, height: 160 },
  { slug: 'fabio-salsa', name: 'Fabio Salsa', width: 925, height: 160 },
  { slug: 'fiat', name: 'Fiat', width: 211, height: 160 },
  { slug: 'givenchy', name: 'Givenchy', width: 1530, height: 160 },
  { slug: 'hennessy', name: 'Hennessy', width: 292, height: 160 },
  { slug: 'ioma', name: 'Ioma', width: 382, height: 160 },
  { slug: 'jp-morgan', name: 'JP Morgan', width: 1147, height: 160 },
  { slug: 'lacoste', name: 'Lacoste', width: 387, height: 160 },
  { slug: 'loreal', name: "L'Oréal", width: 881, height: 160 },
  { slug: 'louboutin', name: 'Louboutin', width: 325, height: 160 },
  { slug: 'maif', name: 'MAIF', width: 203, height: 160 },
  { slug: 'meetic', name: 'Meetic', width: 526, height: 160 },
  { slug: 'messika', name: 'Messika', width: 578, height: 160 },
  { slug: 'ol', name: 'OL', width: 138, height: 160 },
  { slug: 'pgw', name: 'Paris Games Week', width: 160, height: 160 },
  { slug: 'psg', name: 'PSG', width: 160, height: 160 },
  { slug: 'ricard', name: 'Ricard', width: 193, height: 160 },
  { slug: 'sanofi', name: 'Sanofi', width: 624, height: 160 },
  { slug: 'siemens', name: 'Siemens', width: 995, height: 160 },
  { slug: 'soge', name: 'Société Générale', width: 798, height: 160 },
  { slug: 'square', name: 'Square Enix', width: 1526, height: 160 },
  { slug: 'waffle', name: 'Waffle Factory', width: 452, height: 160 },
  { slug: 'yves-rocher', name: 'Yves Rocher', width: 389, height: 160 },
];
---
<section id="about">
  <div class="about-left">
    <h2 class="section-title">{t('about.title')}</h2>
    <div class="about-intro">
      {introParagraphs.map((p: string) => <p set:html={p} />)}
    </div>
    <div class="tools-list">
      <span class="tool-tag">Adobe Premiere Pro</span>
      <span class="tool-tag">DaVinci Resolve</span>
      <span class="tool-tag">Avid Media Composer</span>
      <span class="tool-tag">TriCaster</span>
      <span class="tool-tag">XPression by Ross</span>
      <span class="tool-tag">LSM by EVS</span>
      <span class="tool-tag">Blackmagic ATEM</span>
    </div>

    <!-- PRODUCTIONS -->
    <div class="credits-block">
      <h3 class="credits-heading">{t('about.productions')}</h3>
      <ul class="prod-list">
        <li>Atelier B</li><li>B&amp;A</li><li>Bandits</li>
        <li>Big Bang prod</li><li>Blacklemon</li><li>Bricolo Factory</li>
        <li>Cap TV</li><li>Evrox</li><li>France TV</li>
        <li>Hawlssen Production</li><li>Liik</li><li>Publicis Live</li>
        <li>Studios Paris Sud</li><li>Trimaran</li><li>Way of Live</li>
        <li>West Indies Production</li><li>Wild Buzz Agency</li>
      </ul>
    </div>

    <!-- BRANDS (bandeau défilant de logos) -->
    <div class="credits-block">
      <h3 class="credits-heading">{t('about.brands')}</h3>
      <div class="brand-marquee">
        <div class="brand-marquee-track">
          <!-- Deux groupes identiques, translateX(-50%) en boucle : avec un
               `gap` posé sur .brand-marquee-track, la moitié du track ne
               correspond pas exactement à la largeur d'un groupe (le gap qui
               relie les deux groupes casse la symétrie), d'où un saut visible
               à la relance. En isolant chaque groupe dans son propre flex
               (gap interne + padding-right en bout, sans gap au niveau du
               track), les deux groupes ont une largeur strictement identique
               et -50% tombe pile entre les deux. -->
          <div class="brand-marquee-group">
            {BRANDS.map((b) => (
              <span class="brand-logo">
                <img src={`/brands/${b.slug}.webp`} alt={b.name} width={b.width} height={b.height} loading="lazy" decoding="async" />
              </span>
            ))}
          </div>
          <div class="brand-marquee-group" aria-hidden="true">
            {BRANDS.map((b) => (
              <span class="brand-logo">
                <img src={`/brands/${b.slug}.webp`} alt="" width={b.width} height={b.height} loading="lazy" decoding="async" />
              </span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
