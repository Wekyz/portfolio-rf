---
// Section About - Bio, outils, productions & marques. Les listes viennent de
// data/profile.js, partagé avec llms-full.txt.
import { useTranslations } from '../i18n/strings.js';
import { SOFTWARE, PRODUCTIONS, BRANDS } from '../data/profile.js';
const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
const introParagraphs = t('about.introParagraphs');

// Logos clients (bandeau défilant) - fichiers pré-détourés/redimensionnés
// (voir public/brands/, générés depuis le dossier "Logos RF" fourni par la
// monteuse). Les originaux font 160 px de haut pour un affichage à 32 px
// (.brand-logo img dans styles.css) : le build en tire deux densités, 64 px
// et 96 px, et le srcset laisse le navigateur prendre celle qu'il lui faut.
// Les dimensions viennent de brands.json (mesurées au build, voir
// scripts/fetch-thumbs.mjs) : elles fixent le ratio et évitent un saut de
// mise en page pendant le chargement.
import brandSizes from '../data/brands.json';

const summary =
  lang === 'fr'
    ? `Monteuse vidéo freelance depuis plus de dix ans, basée à Paris et Angers et disponible partout ailleurs. Publicité, long métrage, documentaire, corporate, événementiel, teaser et captation live. Deux prix du meilleur montage. Travail en français et en anglais.`
    : `Freelance video editor for over ten years, based in Paris and Angers and available anywhere else. Commercials, feature films, documentaries, corporate films, events, teasers and live broadcast. Two Best Editing Awards. Works in French and English.`;

const brandImg = (slug: string) => ({
  src: `/brands/${slug}-64.webp`,
  srcset: `/brands/${slug}-64.webp 2x, /brands/${slug}-96.webp 3x`,
  width: brandSizes[slug as keyof typeof brandSizes]?.width,
  height: brandSizes[slug as keyof typeof brandSizes]?.height,
});
---
<section id="about">
  <div class="about-left">
    <h1 class="section-title">{t('about.title')}</h1>
    {/* Synthèse factuelle en tête de bio : ancienneté, domaines, distinctions,
         langues et zone étaient jusqu'ici dispersés dans cinq paragraphes de
         prose, donc difficiles à citer pour un moteur de réponse. Le nombre de
         projets en a été retiré : la monteuse ne veut pas que son travail soit
         annoncé au volume. */}
    <p class="about-summary">{summary}</p>
    <div class="about-intro">
      {introParagraphs.map((p: string) => <p set:html={p} />)}
    </div>
    <div class="tools-list">
      {[...SOFTWARE.editing, ...SOFTWARE.live].map((tool) => <span class="tool-tag">{tool}</span>)}
    </div>

    <!-- DISTINCTIONS -->
    {/* Les deux prix n'existaient que dans une phrase au milieu de la bio.
         Ils sont désormais aussi dans le JSON-LD Person (`award`). */}
    <div class="credits-block">
      <h2 class="credits-heading">{t('about.awards')}</h2>
      <ul class="award-list">
        <li>{t('award.cyprus')}</li>
        <li>{t('award.athens')}</li>
      </ul>
    </div>

    <!-- PRODUCTIONS -->
    <div class="credits-block">
      <h2 class="credits-heading">{t('about.productions')}</h2>
      <ul class="prod-list">
        {PRODUCTIONS.map((name) => <li>{name}</li>)}
      </ul>
    </div>

    <!-- BRANDS (bandeau défilant de logos) -->
    <div class="credits-block">
      <div class="brands-head">
        <h2 class="credits-heading">{t('about.brands')}</h2>
        {/* WCAG 2.2.2 : tout mouvement automatique de plus de 5 secondes doit
             pouvoir être arrêté. L'animation tourne en boucle sur 70 s. Elle se
             met bien en pause au survol, mais le survol n'existe ni au doigt ni
             au clavier ; `prefers-reduced-motion` ne couvre que ceux qui ont
             activé le réglage système. Ce bouton couvre tout le monde, et rend
             aussi service à qui veut simplement lire un logo au passage. */}
        <button
          type="button"
          class="media-toggle"
          id="brandsToggle"
          aria-pressed="false"
          data-label-pause={t('about.brandsPause')}
          data-label-play={t('about.brandsPlay')}
          aria-label={t('about.brandsPause')}
        >
          <svg class="icon-pause" width="10" height="12" viewBox="0 0 10 12" aria-hidden="true">
            <rect x="0" y="0" width="3" height="12" fill="currentColor" />
            <rect x="7" y="0" width="3" height="12" fill="currentColor" />
          </svg>
          <svg class="icon-play" width="10" height="12" viewBox="0 0 10 12" aria-hidden="true">
            <path d="M0 0L10 6L0 12Z" fill="currentColor" />
          </svg>
        </button>
      </div>
      <div class="brand-marquee">
        <div class="brand-marquee-track">
          {/* Deux groupes identiques, translateX(-50%) en boucle : avec un
               `gap` posé sur .brand-marquee-track, la moitié du track ne
               correspond pas exactement à la largeur d'un groupe (le gap qui
               relie les deux groupes casse la symétrie), d'où un saut visible
               à la relance. En isolant chaque groupe dans son propre flex
               (gap interne + padding-right en bout, sans gap au niveau du
               track), les deux groupes ont une largeur strictement identique
               et -50% tombe pile entre les deux. */}
          <div class="brand-marquee-group">
            {BRANDS.map((b) => (
              <span class="brand-logo">
                <img {...brandImg(b.slug)} alt={b.name} loading="lazy" decoding="async" />
              </span>
            ))}
          </div>
          <div class="brand-marquee-group" aria-hidden="true">
            {BRANDS.map((b) => (
              <span class="brand-logo">
                <img {...brandImg(b.slug)} alt="" loading="lazy" decoding="async" />
              </span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
