---
// Lecteur vidéo Vimeo (modale)
import { useTranslations } from '../i18n/strings.js';
const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
---
{/* <dialog> ouvert par showModal() : le reste de la page devient inerte, le
     focus ne peut plus s'en échapper. L'ancien piège à focus fait main
     laissait sortir le focus vers la page derrière depuis « Projet suivant »
     et ignorait le lien de la barre d'information.
     Le nom de la modale est le titre du projet affiché (il s'annonçait
     « Lecteur vidéo » quel que soit le projet) ; la touche Échap est donnée
     en description. */}
<dialog class="lightbox" id="lightbox" aria-labelledby="lightboxTitle" aria-describedby="lightboxHint">
  <p class="visually-hidden" id="lightboxHint">{t('lb.hint')}</p>
  <div class="lightbox-inner">
    <button type="button" class="lightbox-close" id="lightboxClose" aria-label={t('lb.close')}>&times;</button>
    <div class="lightbox-spinner" id="lightboxSpinner" aria-hidden="true"></div>
    <iframe id="lightboxFrame" title={t('lb.frameTitle')} allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>

    {/* Barre d'information et navigation : une fois la vidéo ouverte, plus
         rien n'indiquait ce qu'on regardait ni pour qui, et il fallait fermer
         puis rouvrir pour passer au projet suivant. Les libellés sont remplis
         par app.js depuis les data-* de la vignette cliquée. */}
    <div class="lightbox-bar">
      <button type="button" class="lightbox-nav" id="lightboxPrev" aria-label={t('lb.prev')}>&larr;</button>
      <div class="lightbox-info">
        <p class="lightbox-title" id="lightboxTitle"></p>
        <p class="lightbox-meta" id="lightboxMeta"></p>
      </div>
      {/* Lien externe du projet (film en plateforme, par exemple), affiché
           seulement s'il existe. Il remplace le lien vers la fiche projet,
           retiré à la demande de la monteuse le temps de définir le
           contenu des fiches. */}
      <a class="lightbox-ext" id="lightboxExt" href="" target="_blank" rel="noopener noreferrer" hidden>{t('project.watchFull')} &rarr;</a>
      <button type="button" class="lightbox-nav" id="lightboxNext" aria-label={t('lb.next')}>&rarr;</button>
    </div>
  </div>
</dialog>
