---
/**
 * Bloc pratique de la page /contact : zone d'intervention, langues, conditions
 * de travail et canaux directs. Complète le formulaire plutôt qu'il ne le
 * remplace.
 *
 * Les conditions de travail (délais, formats, validation...) viennent de
 * PRACTICAL dans data/profile.js : seules les entrées renseignées s'affichent.
 */
import { useTranslations } from '../i18n/strings.js';
import { CONTACT } from '../data/contact.js';
import { PRACTICAL } from '../data/profile.js';

interface Props {
  lang?: 'en' | 'fr';
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
const practical = Object.entries(PRACTICAL).flatMap(([key, value]) =>
  value ? [{ key, text: value[lang] }] : []
);
---
<section class="contact-info">
  <dl>
    <div>
      <dt>{t('contactPage.area')}</dt>
      <dd>{t('work.location')}</dd>
    </div>
    <div>
      <dt>{t('contactPage.languages')}</dt>
      <dd>{t('contactPage.languagesValue')}</dd>
    </div>
    {practical.map(({ key, text }) => (
      <div class="contact-fact">
        <dt>{t(`contactPage.${key}`)}</dt>
        <dd>{text}</dd>
      </div>
    ))}
    <div>
      <dt>{t('contactPage.elsewhere')}</dt>
      <dd>
        <a href={CONTACT.imdb} target="_blank" rel="noopener noreferrer me">IMDb</a>
        {/* Le bouton n'apparaît que si un lien est renseigné - voir
            data/contact.js pour le format attendu (lien court WhatsApp
            Business, le seul qui ne dévoile pas le numéro). */}
        {CONTACT.whatsapp && (
          <a href={CONTACT.whatsapp} target="_blank" rel="noopener noreferrer">WhatsApp</a>
        )}
      </dd>
    </div>
  </dl>
</section>
