---
// Section Contact + formulaire (envoyé via la fonction /api/contact -> Resend)
//
// Présente en bas des pages Portfolio et À propos, et seule sur la page
// /contact. D'où le niveau de titre paramétrable : sur sa propre page elle
// porte le H1, ailleurs elle reste une section parmi d'autres.
import { useTranslations } from '../i18n/strings.js';

interface Props {
  lang?: 'en' | 'fr';
  level?: 'h1' | 'h2';
}

const { lang = 'en', level = 'h2' } = Astro.props;
const Heading = level;
const t = useTranslations(lang);
---
<section id="contact">
  <div class="contact-left">
    <Heading class="section-title">{t('contact.title')}</Heading>
    <p class="contact-tagline">{t('contact.tagline1')}<br /><em>{t('contact.tagline2')}</em></p>
    <p class="contact-desc">{t('contact.desc')}</p>
    <div class="contact-links">
      {/* data-astro-prefetch="false" : `prefetchAll` (astro.config.mjs)
           précharge tout lien interne au survol, or celui-ci n'est pas une
           page mais une fonction serverless qui répond par une redirection
           302 vers un `mailto:`. La précharger n'apporte rien et déclenche
           une invocation de la fonction à chaque survol du lien. */}
      <a href="/api/email" class="contact-link" id="email-link" data-astro-prefetch="false">
        <span class="contact-link-arrow" aria-hidden="true"></span>
        <span>{t('contact.emailLink')}</span>
      </a>
    </div>
  </div>

  <form class="contact-form" name="contact" method="POST" action="/api/contact">
    <p class="hp-field" aria-hidden="true">
      <label>{t('contact.honeypot')} <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
    </p>

    <div class="form-row">
      <div class="form-group">
        <label for="first-name">{t('contact.firstName')}</label>
        <input id="first-name" type="text" name="first-name" placeholder={t('contact.firstNamePh')} autocomplete="given-name" required />
      </div>
      <div class="form-group">
        <label for="last-name">{t('contact.lastName')}</label>
        <input id="last-name" type="text" name="last-name" placeholder={t('contact.lastNamePh')} autocomplete="family-name" required />
      </div>
    </div>

    <div class="form-group">
      <label for="email">{t('contact.email')}</label>
      <input id="email" type="email" name="email" placeholder={t('contact.emailPh')} autocomplete="email" required />
    </div>

    <div class="form-group">
      <label for="message">{t('contact.message')}</label>
      <textarea id="message" name="message" rows="5" placeholder={t('contact.messagePh')}></textarea>
    </div>

    <button type="submit" class="form-submit">
      {t('contact.send')}
      <svg width="16" height="10" viewBox="0 0 16 10" fill="none" aria-hidden="true">
        <path d="M0 5H14M10 1L14 5L10 9" stroke="white" stroke-width="1.2"/>
      </svg>
    </button>
    <p class="visually-hidden" id="formStatus" role="status" aria-live="polite"></p>
  </form>
</section>
