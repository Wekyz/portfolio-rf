---
// Bouton flottant "haut de page" - affiché après un peu de scroll (voir
// app.js). Présent sur Portfolio et About (pages longues à défiler).
import { useTranslations } from '../i18n/strings.js';
const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
---
<button type="button" class="back-to-top" id="backToTop" aria-label={t('a11y.backToTop')}>
  <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
    <path d="M8 13V3M3 7L8 2L13 7" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
</button>
