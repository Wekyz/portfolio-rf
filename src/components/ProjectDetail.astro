---
/**
 * Corps d'une page projet : lecteur visible, informations, maillage interne.
 *
 * Le lecteur est délibérément en tête de page, à pleine largeur de colonne et
 * sans `loading="lazy"` : c'est la condition pour que Google indexe la vidéo
 * (dans la zone rendue au chargement, > 140 px de haut, > 140 px de large et
 * au moins un tiers de la page). Ne pas le repousser sous un pli ni le
 * réduire sans revoir le VideoObject de lib/project-page.js.
 */
import { useTranslations } from '../i18n/strings.js';
import { resolveThumb } from '../lib/thumb.js';
import { localImages } from '../lib/images.js';
import Thumb from './Thumb.astro';
import { embedUrl } from '../lib/project-page.js';
import { creditParts, creditLine } from '../lib/credits.js';
import type { Project } from '../lib/types';

interface Props {
  project: Project;
  related?: { project: Project; slug: string }[];
  siblings?: { prev: { project: Project; slug: string }; next: { project: Project; slug: string } } | null;
  lang?: 'en' | 'fr';
}

const { project: p, related = [], siblings = null, lang = 'en' } = Astro.props;
const t = useTranslations(lang);
const langBase = lang === 'fr' ? '/fr' : '';

// Vignette posée derrière le lecteur. Un iframe n'est pas candidat LCP : sur
// mobile, Lighthouse retenait la première vignette « Dans la même
// catégorie », chargée en lazy, tout en bas de page. L'image devient
// l'élément LCP, chargée en priorité, et sert de fond pendant que le lecteur
// Vimeo démarre. L'iframe reste en place et par-dessus : c'est lui qui
// conditionne l'indexation de la vidéo (voir l'en-tête de ce fichier).
const poster = resolveThumb(p, { local: localImages });

// Découpage en paragraphes fait ici et non dans le template : une regex
// contenant `{2,}` y serait lue comme une expression JSX par le vérificateur
// de types et par ESLint (le compilateur Astro, lui, l'acceptait - d'où une
// erreur invisible au build).
const paragraphs = p.description
  ? p.description.split(/\n{2,}/).map((s) => s.trim()).filter(Boolean)
  : [];

// `values` (au pluriel) plutôt que `value` quand le fait en compte plusieurs :
// les distinctions concaténées sur une ligne faisaient 110 caractères et,
// dans un conteneur en `flex-wrap`, cet élément unique poussait la catégorie
// à l'autre bout de la rangée. Une par ligne, la colonne reprend une largeur
// normale et chaque prix se lit d'un coup d'œil.
const facts: { label: string; value?: string; values?: string[] }[] = [];
for (const { label, value } of creditParts(p, lang)) facts.push({ label, value });
if (p.year) facts.push({ label: t('project.year'), value: p.year });
// Posées juste après l'année : ce sont les faits les plus forts d'un projet
// qui en porte, et elles étaient jusqu'ici noyées dans le champ crédit.
if (p.awards?.length) facts.push({ label: t('project.awards'), values: p.awards });
facts.push({ label: t('project.category'), value: t(`cat.${p.cat}`) });
---
<article class="project">
  {/* Fil d'Ariane : sert à la fois de navigation retour et de source au
       BreadcrumbList JSON-LD (voir lib/project-page.js), que Google utilise
       pour afficher un chemin lisible à la place de l'URL brute. */}
  <nav class="project-crumbs" aria-label={t('project.breadcrumb')}>
    <ol>
      <li><a href={langBase || '/'}>{t('nav.home')}</a></li>
      <li><a href={`${langBase}/portfolio`}>{t('nav.work')}</a></li>
      <li aria-current="page">{p.title}</li>
    </ol>
  </nav>

  <header class="project-head">
    <p class="project-cat">{t(`cat.${p.cat}`)}</p>
    <h1 class="project-title">{p.title}</h1>
  </header>

  <div class="project-player">
    {poster.src && (
      <Thumb
        class="project-player-poster"
        src={poster.src}
        srcset={poster.srcset}
        avifSrcset={poster.avifSrcset}
        sizes="(max-width: 900px) 100vw, (max-width: 1180px) calc(100vw - 112px), 1068px"
        alt=""
        fetchpriority="high"
        decoding="async"
        width="1280"
        height="800"
      />
    )}
    <iframe
      src={embedUrl(p)}
      title={`${p.title} - ${t('project.playerTitle')}`}
      allow="autoplay; fullscreen; picture-in-picture"
      allowfullscreen
    ></iframe>
  </div>

  {paragraphs.length > 0 && (
    <div class="project-text">
      {paragraphs.map((para) => <p>{para}</p>)}
    </div>
  )}

  <dl class="project-facts">
    {facts.map((f) => (
      <div class="project-fact">
        <dt>{f.label}</dt>
        <dd>
          {f.values ? (
            <ul class="project-fact-list">{f.values.map((v) => <li>{v}</li>)}</ul>
          ) : (
            f.value
          )}
        </dd>
      </div>
    ))}
  </dl>

  {p.externalLink && (
    <p class="project-cta">
      <a href={p.externalLink} target="_blank" rel="noopener noreferrer">
        {t('project.watchFull')} &rarr;
      </a>
    </p>
  )}

  {/* Parcours de la catégorie fiche par fiche, et lien à copier pour
       l'envoyer à une production. Le bouton n'apparaît que si le
       presse-papiers est disponible (voir app.js). */}
  <nav class="project-pager" aria-label={t('project.pagerAria')}>
    {siblings && (
      <a class="project-pager-link" href={`${langBase}/portfolio/${siblings.prev.slug}`} rel="prev">
        <span class="project-pager-label">&larr; {t('project.prev')}</span>
        <span class="project-pager-title">{siblings.prev.project.title}</span>
      </a>
    )}
    <button type="button" class="project-copy" id="copyLink" data-copied={t('project.copied')} hidden>
      {t('project.copyLink')}
    </button>
    {siblings && (
      <a class="project-pager-link project-pager-next" href={`${langBase}/portfolio/${siblings.next.slug}`} rel="next">
        <span class="project-pager-label">{t('project.next')} &rarr;</span>
        <span class="project-pager-title">{siblings.next.project.title}</span>
      </a>
    )}
  </nav>

  {related.length > 0 && (
    <section class="project-related">
      <h2>{t('project.related')}</h2>
      <ul>
        {related.map(({ project: r, slug }) => {
          const { src, srcset, avifSrcset } = resolveThumb(r, { local: localImages });
          return (
            <li>
              <a href={`${langBase}/portfolio/${slug}`}>
                {src && (
                  <Thumb
                    src={src}
                    srcset={srcset}
                    avifSrcset={avifSrcset}
                    sizes="(max-width: 900px) 100vw, (min-width: 1180px) 340px, calc((100vw - 160px) / 3)"
                    alt={r.title}
                    loading="lazy"
                    decoding="async"
                    width="1280"
                    height="800"
                  />
                )}
                <span class="project-related-title">{r.title}</span>
                {creditLine(r, lang) && <span class="project-related-credit">{creditLine(r, lang)}</span>}
              </a>
            </li>
          );
        })}
      </ul>
    </section>
  )}
</article>
