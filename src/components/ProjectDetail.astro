---
/**
 * Corps d'une page projet : lecteur visible, informations, maillage interne.
 *
 * Le lecteur est délibérément en tête de page, à pleine largeur de colonne et
 * sans `loading="lazy"` : c'est la condition pour que Google indexe la vidéo
 * (dans la zone rendue au chargement, > 140 px de haut, > 140 px de large et
 * au moins un tiers de la page). Ne pas le repousser sous un pli ni le
 * réduire sans revoir le VideoObject de lib/project-page.js.
 */
import { useTranslations } from '../i18n/strings.js';
import { resolveThumb, getDuration } from '../lib/thumb.js';
import { embedUrl, formatDuration } from '../lib/project-page.js';
import type { Project } from '../lib/types';

interface Props {
  project: Project;
  related?: { project: Project; slug: string }[];
  lang?: 'en' | 'fr';
}

const { project: p, related = [], lang = 'en' } = Astro.props;
const t = useTranslations(lang);
const langBase = lang === 'fr' ? '/fr' : '';

// La durée était déjà résolue au build pour le JSON-LD sans jamais être
// montrée. Même remarque que l'année dans la grille : c'est une information
// que cherchent les productions.
const duration = formatDuration(getDuration(p));

// Découpage en paragraphes fait ici et non dans le template : une regex
// contenant `{2,}` y serait lue comme une expression JSX par le vérificateur
// de types et par ESLint (le compilateur Astro, lui, l'acceptait - d'où une
// erreur invisible au build).
const paragraphs = p.description
  ? p.description.split(/\n{2,}/).map((s) => s.trim()).filter(Boolean)
  : [];

// `values` (au pluriel) plutôt que `value` quand le fait en compte plusieurs :
// les distinctions concaténées sur une ligne faisaient 110 caractères et,
// dans un conteneur en `flex-wrap`, cet élément unique poussait la durée et la
// catégorie à l'autre bout de la rangée. Une par ligne, la colonne reprend une
// largeur normale et chaque prix se lit d'un coup d'œil.
const facts: { label: string; value?: string; values?: string[] }[] = [];
if (p.credit) facts.push({ label: t('project.production'), value: p.credit });
if (p.year) facts.push({ label: t('project.year'), value: p.year });
// Posées juste après l'année : ce sont les faits les plus forts d'un projet
// qui en porte, et elles étaient jusqu'ici noyées dans le champ crédit.
if (p.awards?.length) facts.push({ label: t('project.awards'), values: p.awards });
if (duration) facts.push({ label: t('project.duration'), value: duration });
facts.push({ label: t('project.category'), value: t(`cat.${p.cat}`) });
---
<article class="project">
  {/* Fil d'Ariane : sert à la fois de navigation retour et de source au
       BreadcrumbList JSON-LD (voir lib/project-page.js), que Google utilise
       pour afficher un chemin lisible à la place de l'URL brute. */}
  <nav class="project-crumbs" aria-label={t('project.breadcrumb')}>
    <ol>
      <li><a href={langBase || '/'}>{t('nav.home')}</a></li>
      <li><a href={`${langBase}/portfolio`}>{t('nav.work')}</a></li>
      <li aria-current="page">{p.title}</li>
    </ol>
  </nav>

  <header class="project-head">
    <p class="project-cat">{t(`cat.${p.cat}`)}</p>
    <h1 class="project-title">{p.title}</h1>
  </header>

  <div class="project-player">
    <iframe
      src={embedUrl(p)}
      title={`${p.title} - ${t('project.playerTitle')}`}
      allow="autoplay; fullscreen; picture-in-picture"
      allowfullscreen
    ></iframe>
  </div>

  {paragraphs.length > 0 && (
    <div class="project-text">
      {paragraphs.map((para) => <p>{para}</p>)}
    </div>
  )}

  <dl class="project-facts">
    {facts.map((f) => (
      <div class="project-fact">
        <dt>{f.label}</dt>
        <dd>
          {f.values ? (
            <ul class="project-fact-list">{f.values.map((v) => <li>{v}</li>)}</ul>
          ) : (
            f.value
          )}
        </dd>
      </div>
    ))}
  </dl>

  {p.externalLink && (
    <p class="project-cta">
      <a href={p.externalLink} target="_blank" rel="noopener noreferrer">
        {t('project.watchFull')} &rarr;
      </a>
    </p>
  )}

  {related.length > 0 && (
    <section class="project-related">
      <h2>{t('project.related')}</h2>
      <ul>
        {related.map(({ project: r, slug }) => {
          const { src, srcset } = resolveThumb(r);
          return (
            <li>
              <a href={`${langBase}/portfolio/${slug}`}>
                {src && (
                  <img
                    src={src}
                    srcset={srcset}
                    sizes="(max-width: 900px) 100vw, 33vw"
                    alt={r.title}
                    loading="lazy"
                    decoding="async"
                    width="1280"
                    height="800"
                  />
                )}
                <span class="project-related-title">{r.title}</span>
                {r.credit && <span class="project-related-credit">{r.credit}</span>}
              </a>
            </li>
          );
        })}
      </ul>
    </section>
  )}
</article>
