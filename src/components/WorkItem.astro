---
/**
 * Une vignette de la grille Work. Rendu au build (équivalent de buildItem()
 * dans l'ancien app.js). Le placement (classe CSS + largeur en colonnes) est
 * calculé en amont et passé via la prop `placement` (voir lib/spans.js).
 */

import { useTranslations } from '../i18n/strings.js';
import { resolveThumb } from '../lib/thumb.js';

const { project, placement, priority = false, lang = 'en' } = Astro.props;
const t = useTranslations(lang);
const p = project;

// Les premières vignettes (au-dessus de la ligne de flottaison) sont chargées
// en priorité : `eager` + `fetchpriority=high` améliore le LCP. Le reste reste
// en `lazy`.
const loading = priority ? 'eager' : 'lazy';
const fetchpriority = priority ? 'high' : undefined;

const interactive = !p.noClick && (p.id || p.externalLink);
const prod = p.credit || t(`cat.${p.cat}`) || p.cat;
const imgWidth = p.portrait ? 600 : 1280;
const imgHeight = p.portrait ? 900 : 800;

const { src: thumbSrc, srcset: thumbSrcset, responsive } = resolveThumb(p);
const spanN = placement?.span ?? 6;
const sizes = responsive
  ? `(max-width: 900px) 100vw, ${Math.round((spanN / 12) * 100)}vw`
  : undefined;
---

<div
  class:list={['work-item', placement?.cls]}
  data-cat={p.cat}
  data-id={p.id || ''}
  data-hash={p.hash || ''}
  data-external={p.externalLink || ''}
  data-full-width={p.fullWidth ? 'true' : undefined}
  data-portrait={p.portrait ? 'true' : undefined}
>
  {interactive ? (
    <button type="button" class="work-thumb-wrap" aria-label={`${t('work.watchAria')} - ${p.title}`}>
      {thumbSrc && (
        <img
          class="work-thumb"
          src={thumbSrc}
          srcset={thumbSrcset}
          sizes={sizes}
          alt={p.title}
          loading={loading}
          fetchpriority={fetchpriority}
          decoding="async"
          width={imgWidth}
          height={imgHeight}
        />
      )}
      <div class="work-overlay">
        <div class="work-play">
          {p.externalLink ? (
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
              <path
                d="M7 3H3a1 1 0 00-1 1v11a1 1 0 001 1h11a1 1 0 001-1v-4M10 2h6v6M15 3l-7 7"
                stroke="white"
                stroke-width="1.4"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          ) : (
            <svg width="14" height="16" viewBox="0 0 14 16" fill="none" aria-hidden="true">
              <path d="M1 1L13 8L1 15V1Z" fill="white" />
            </svg>
          )}
        </div>
        <div class="work-info">
          <div class="work-title">{p.title}</div>
          <div class="work-meta"><span class="work-prod">{prod}</span></div>
          {p.externalLink && <span class="work-badge">{t('work.watch')} &rarr;</span>}
        </div>
      </div>
    </button>
  ) : (
    <div class="work-thumb-wrap">
      {thumbSrc && (
        <img
          class="work-thumb"
          src={thumbSrc}
          srcset={thumbSrcset}
          sizes={sizes}
          alt={p.title}
          loading={loading}
          fetchpriority={fetchpriority}
          decoding="async"
          width={imgWidth}
          height={imgHeight}
        />
      )}
      <div class="work-overlay">
        <div class="work-play">
          <svg width="14" height="16" viewBox="0 0 14 16" fill="none" aria-hidden="true">
            <path d="M1 1L13 8L1 15V1Z" fill="white" />
          </svg>
        </div>
        <div class="work-info">
          <div class="work-title">{p.title}</div>
          <div class="work-meta"><span class="work-prod">{prod}</span></div>
        </div>
      </div>
    </div>
  )}
  {p.id && (
    // Lecteur réel présent dans le HTML (masqué, chargement différé) : la
    // lightbox (voir Lightbox.astro/app.js) réutilise le même src au clic
    // pour l'expérience utilisateur, mais Google a besoin qu'un <iframe>
    // vers le player soit effectivement présent sur la page pour indexer la
    // vidéo (cf. Search Console : "la vidéo n'est pas sur une page de lecture").
    <div class="work-embed" aria-hidden="true">
      <iframe
        class="work-embed-frame"
        loading="lazy"
        tabindex="-1"
        src={`https://player.vimeo.com/video/${p.id}${p.hash ? `?h=${p.hash}` : ''}`}
        title={p.title}
        allow="autoplay; fullscreen; picture-in-picture"
      ></iframe>
    </div>
  )}
</div>
